        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF' }}>02 系统链路与控制模式边界</Text>
        <Text style={{ fontSize: 20, color: '#BFD3EE' }}>TwinCAT 3 · EtherCAT · STM32H743 · DRV8323</Text>
    </Box>
    <Box style={{ height: 588, paddingTop: 24, paddingBottom: 16, paddingLeft: 40, paddingRight: 40, flexDirection: 'row', gap: 24 }}>
        <Box style={{ width: 720, height: '100%', alignItems: 'center', justifyContent: 'center', gap: 18 }}>
            <svg width={720} height={318} viewBox='0 0 680 300'>
                <defs>
                    <marker id='arrow' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto-start-reverse'>
                        <path d='M2 1L8 5L2 9' fill='none' stroke='context-stroke' strokeWidth='1.5' strokeLinecap='round' strokeLinejoin='round' />
                    </marker>
                </defs>
                <text x='341' y='40' textAnchor='middle' fontSize='12.5' fill='#1E4FA8'>TxPDO：电流采样值与本地状态回传</text>
                <path d='M584 76 L584 50 L98 50 L98 68' fill='none' stroke='#3D7BD9' strokeWidth='1.5' strokeDasharray='4 3' markerEnd='url(#arrow)' />
