                <text x='230' y='114' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#1E4FA8'>RxPDO 周期帧</text>
                <path d='M280 104 L298 104' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                <rect x='304' y='76' width='104' height='56' rx='8' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='0.5' />
                <text x='356' y='96' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>LAN9252</text>
                <text x='356' y='114' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#1E4FA8'>ESC 从站芯片</text>
                <path d='M408 104 L426 104' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                <rect x='432' y='76' width='72' height='56' rx='8' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='0.5' />
                <text x='468' y='96' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>SPI1</text>
                <text x='468' y='114' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#1E4FA8'>过程数据</text>
                <path d='M504 104 L522 104' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                <rect x='528' y='76' width='112' height='56' rx='8' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='0.5' />
                <text x='584' y='96' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>STM32H743</text>
                <text x='584' y='114' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#1E4FA8'>桥接与状态机</text>
                <path d='M584 132 L584 159 L110 159 L110 180' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                <rect x='40' y='186' width='140' height='56' rx='8' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='0.5' />
                <text x='110' y='206' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>电流环</text>
                <text x='110' y='224' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#3D7BD9'>对齐 0.5A / Iq 0.8A</text>
                <path d='M180 214 L198 214' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                <rect x='204' y='186' width='140' height='56' rx='8' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='0.5' />
                <text x='274' y='206' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>TIM8 PWM</text>
                <text x='274' y='224' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#3D7BD9'>六路互补 约 10kHz</text>
                <path d='M344 214 L362 214' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                <rect x='368' y='186' width='140' height='56' rx='8' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='0.5' />
                <text x='438' y='206' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>DRV8323</text>
                <text x='438' y='224' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#3D7BD9'>栅极驱动 三相桥</text>
                <path d='M508 214 L526 214' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                <rect x='532' y='186' width='108' height='56' rx='8' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='0.5' />
                <text x='586' y='206' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>电机</text>
                <text x='586' y='224' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#3D7BD9'>10 对极 空载</text>
                <text x='348' y='266' textAnchor='middle' fontSize='12.5' fill='#3D7BD9'>ADC 注入采样 JDR1 / JDR2</text>
                <path d='M586 242 L586 278 L110 278 L110 248' fill='none' stroke='#3D7BD9' strokeWidth='1.5' strokeDasharray='4 3' markerEnd='url(#arrow)' />
            </svg>
            <Box style={{ width: '100%', height: 56, background: '#F0F5FC', borderLeft: '6px solid #3D7BD9', paddingLeft: 22, paddingRight: 22, justifyContent: 'center' }}>
                <Text style={{ fontSize: 20, color: '#1A2230' }}>指令向下走「主站 → 从站 → MCU → 功率级」，电流采样与本地状态沿原路回传</Text>
            </Box>
        </Box>
        <Box style={{ width: 456, height: '100%', gap: 16 }}>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, paddingTop: 22, paddingBottom: 22, paddingLeft: 24, paddingRight: 24, justifyContent: 'space-between' }}>
                <Box style={{ gap: 14 }}>
                    <Box style={{ background: '#E8EFF8', borderRadius: 4, paddingTop: 6, paddingBottom: 6, paddingLeft: 12, paddingRight: 12, alignSelf: 'flex-start' }}>
                        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0E3F8C' }}>模式 2 与控制边界</Text>
                    </Box>
                    <Text style={{ fontSize: 22, color: '#4A5568' }}>当前采用「虚拟电角度 + 电流闭环」，由 MCU 对给定频率积分得到电气角，不使用编码器反馈；OP 只说明通信进入运行状态，不代表电机已启动或转速已闭环。</Text>
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#D9534F' }}>它不是编码器速度闭环</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, paddingTop: 22, paddingBottom: 22, paddingLeft: 24, paddingRight: 24, justifyContent: 'space-between' }}>
                <Box style={{ gap: 14 }}>
                    <Box style={{ background: '#E8EFF8', borderRadius: 4, paddingTop: 6, paddingBottom: 6, paddingLeft: 12, paddingRight: 12, alignSelf: 'flex-start' }}>
                        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0E3F8C' }}>主站与从站的分工</Text>
                    </Box>
                    <Text style={{ fontSize: 22, color: '#4A5568' }}>在 MAIN 写入需求 6，PLC 乘 10 形成 TargetSpeed=60 的 PDO 输出；H743 桥接层解析后交给模式 2 策略，换算为电角频率，再由电流环与 PWM 执行。</Text>
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E4FA8' }}>主站不逐点生成六路 PWM</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>STM32H743-VOFA 电机控制平台</Text>
        <Text style={{ fontSize: 16, color: '#1E4FA8' }}>04 / 11</Text>
    </Box>
</Slide>
