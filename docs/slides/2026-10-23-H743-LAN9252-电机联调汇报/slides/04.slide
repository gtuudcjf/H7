                <text x='98' y='114' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#1E4FA8'>PC 主站</text>
                <path d='M156 104 L174 104' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                <rect x='180' y='76' width='100' height='56' rx='8' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='0.5' />
