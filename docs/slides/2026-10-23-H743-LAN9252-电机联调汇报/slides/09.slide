<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei, SimHei, sans-serif' }}>
    <Box style={{ height: 72, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF' }}>05 相位状态机与故障恢复</Text>
        <Text style={{ fontSize: 20, color: '#BFD3EE' }}>nPhase 0 / 10 / 20 / 30 / 80 / 90</Text>
    </Box>
    <Box style={{ height: 588, paddingTop: 24, paddingBottom: 16, paddingLeft: 40, paddingRight: 40 }}>
        <Box style={{ height: 46, background: '#F0F5FC', borderLeft: '6px solid #1E4FA8', paddingLeft: 22, paddingRight: 22, justifyContent: 'center' }}>
            <Text style={{ fontSize: 21, color: '#1A2230' }}>正常路径是一条环，故障路径是一条必须先释放、再复位、再重启的支路</Text>
        </Box>
        <Box style={{ height: 8 }} />
        <Box style={{ flexDirection: 'row', height: 440, gap: 24 }}>
            <Box style={{ width: 700, height: 440, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                <svg width={660} height={310} viewBox='0 0 680 320'>
                    <defs>
                        <marker id='arrow' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='6' markerHeight='6' orient='auto-start-reverse'>
                            <path d='M2 1L8 5L2 9' fill='none' stroke='context-stroke' strokeWidth='1.5' strokeLinecap='round' strokeLinejoin='round' />
                        </marker>
                    </defs>
                    <rect x='40' y='76' width='124' height='56' rx='8' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='0.5' />
                    <text x='102' y='96' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>0 待机</text>
                    <text x='102' y='114' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#1E4FA8'>输出关闭</text>
                    <text x='180' y='64' textAnchor='middle' fontSize='12.5' fill='#4A5568'>bStart 上升沿</text>
                    <path d='M164 104 L190 104' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                    <rect x='196' y='76' width='124' height='56' rx='8' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='0.5' />
                    <text x='258' y='96' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>10 启动</text>
                    <text x='258' y='114' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#1E4FA8'>对齐 0.5A / 0.75s</text>
                    <text x='336' y='64' textAnchor='middle' fontSize='12.5' fill='#4A5568'>对齐完成</text>
                    <path d='M320 104 L346 104' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                    <rect x='352' y='76' width='124' height='56' rx='8' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='0.5' />
                    <text x='414' y='96' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>20 运行</text>
                    <text x='414' y='114' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#1E4FA8'>Iq 0.8A，最长 6s</text>
                    <text x='492' y='64' textAnchor='middle' fontSize='12.5' fill='#4A5568'>bStop</text>
                    <path d='M476 104 L502 104' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                    <rect x='508' y='76' width='124' height='56' rx='8' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='0.5' />
                    <text x='570' y='96' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>30 停止</text>
                    <text x='570' y='114' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#1E4FA8'>目视确认停稳</text>
                    <text x='336' y='168' textAnchor='middle' fontSize='12.5' fill='#D9534F'>故障</text>
                    <path d='M414 132 L414 176 L258 176 L258 194' fill='none' stroke='#D9534F' strokeWidth='1.5' markerEnd='url(#arrow)' />
                    <rect x='196' y='200' width='124' height='56' rx='8' fill='#FBEAEA' stroke='#D9534F' strokeWidth='0.5' />
                    <text x='258' y='220' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#D9534F'>90 故障锁存</text>
                    <text x='258' y='238' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#D9534F'>不会自动清除</text>
                    <path d='M320 228 L346 228' fill='none' stroke='#D9534F' strokeWidth='1.5' markerEnd='url(#arrow)' />
                    <rect x='352' y='200' width='124' height='56' rx='8' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='0.5' />
                    <text x='414' y='220' textAnchor='middle' dominantBaseline='central' fontSize='14' fontWeight='bold' fill='#0E3F8C'>80 复位</text>
                    <text x='414' y='238' textAnchor='middle' dominantBaseline='central' fontSize='12.5' fill='#1E4FA8'>清锁存回待机</text>
                    <text x='336' y='272' textAnchor='middle' fontSize='12.5' fill='#D9534F'>bReset 上升沿（先 bStart=FALSE）</text>
                    <path d='M414 256 L414 284 L95 284 L95 138' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                    <text x='520' y='292' textAnchor='middle' fontSize='12.5' fill='#4A5568'>回到待机</text>
                    <path d='M570 132 L570 300 L125 300 L125 138' fill='none' stroke='#8B97A8' strokeWidth='1.5' markerEnd='url(#arrow)' />
                </svg>
            </Box>
            <Box style={{ width: 476, height: 440, gap: 16 }}>
                <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, paddingTop: 16, paddingBottom: 16, paddingLeft: 20, paddingRight: 20, gap: 6 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>故障复位四步</Text>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                        <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                        </Box>
                        <Text style={{ fontSize: 19, color: '#1A2230' }}>先释放：把 bStart 写回 FALSE</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                        <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                        </Box>
                        <Text style={{ fontSize: 19, color: '#1A2230' }}>给边沿：bReset 写 TRUE 再写回 FALSE</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                        <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                        </Box>
                        <Text style={{ fontSize: 19, color: '#1A2230' }}>查状态：nPhase=0 且 bLocalFault=FALSE</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                        <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>4</Text>
                        </Box>
                        <Text style={{ fontSize: 19, color: '#1A2230' }}>再启动：重新发送 bStart 上升沿</Text>
                    </Box>
                </Box>
                <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8, paddingTop: 16, paddingBottom: 16, paddingLeft: 20, paddingRight: 20, gap: 8 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>两层状态必须分开看</Text>
                    <Text style={{ fontSize: 19, color: '#4A5568' }}>通信层：State=8、WcState=FALSE</Text>
                    <Text style={{ fontSize: 19, color: '#4A5568' }}>应用层：nPhase、bLocalFault</Text>
                    <Text style={{ fontSize: 19, color: '#4A5568' }}>故障码：12 时限 / 13 换向 / 14 停止超时</Text>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#D9534F' }}>通信恢复不等于故障锁存被清除</Text>
                </Box>
            </Box>
        </Box>
        <Box style={{ height: 8 }} />
        <Box style={{ height: 46, background: '#0E3F8C', borderRadius: 8, paddingLeft: 28, paddingRight: 28, justifyContent: 'center' }}>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#FFFFFF' }}>复位靠上升沿而不是电平，且必须先释放 bStart——这是本阶段最容易踩的操作点</Text>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>STM32H743-VOFA 电机控制平台</Text>
        <Text style={{ fontSize: 16, color: '#1E4FA8' }}>09 / 11</Text>
    </Box>
</Slide>
