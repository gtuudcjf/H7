<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '0px' }}>
    <Box style={{ width: '100%', height: '72px', background: '#0E3F8C', padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: '34px', fontWeight: 'bold', color: '#FFFFFF' }}>实板调试主流程：六个阶段与各自的现象、处理、结果</Text>
        <Text style={{ fontSize: '16px', color: '#9DBDF0' }}>实板调试复盘</Text>
    </Box>
    <Box style={{ width: '100%', height: '608px', padding: '14px 40px', gap: '16px' }}>
        <Box style={{ width: '1198px', height: '246px', flexDirection: 'row', gap: '20px' }}>
            <Box style={{ width: '386px', height: '246px', background: '#F7F9FC', border: '1px solid #E5E7EB', borderRadius: '6px', padding: '14px 16px', gap: '6px' }}>
                <Box style={{ width: '100%', height: '40px', flexDirection: 'row', alignItems: 'center', gap: '10px' }}>
                    <Box style={{ width: '34px', height: '34px', borderRadius: '4px', background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: '18px', fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                    </Box>
                    <Box style={{ gap: '2px' }}>
                        <Text style={{ fontSize: '20px', fontWeight: 'bold', color: '#1A2230' }}>移植隔离</Text>
                        <Text style={{ fontSize: '15px', color: '#8B97A8' }}>10/01–10/03</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>起点：F407 参考工程含电机、编码器、ADC、PWM</Text>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>处理：只保留 SSC 核心，隔离功率级</Text>
                <Text style={{ fontSize: '18px', color: '#1E4FA8', lineHeight: '1.5' }}>结果：主机测试通过，构建 0 error</Text>
            </Box>
            <Box style={{ width: '386px', height: '246px', background: '#F7F9FC', border: '1px solid #E5E7EB', borderRadius: '6px', padding: '14px 16px', gap: '6px' }}>
                <Box style={{ width: '100%', height: '40px', flexDirection: 'row', alignItems: 'center', gap: '10px' }}>
                    <Box style={{ width: '34px', height: '34px', borderRadius: '4px', background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: '18px', fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                    </Box>
                    <Box style={{ gap: '2px' }}>
                        <Text style={{ fontSize: '20px', fontWeight: 'bold', color: '#1A2230' }}>空白 EEPROM</Text>
                        <Text style={{ fontSize: '15px', color: '#8B97A8' }}>10/14</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>现象：设备 FFFFFFFF，EEPROM 可见全 FF</Text>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>处理：备份原内容，写入匹配 SII 并重新上电</Text>
                <Text style={{ fontSize: '18px', color: '#1E4FA8', lineHeight: '1.5' }}>结果：设备名恢复，PDI 低字节 0x80</Text>
            </Box>
            <Box style={{ width: '386px', height: '246px', background: '#F7F9FC', border: '1px solid #E5E7EB', borderRadius: '6px', padding: '14px 16px', gap: '6px' }}>
                <Box style={{ width: '100%', height: '40px', flexDirection: 'row', alignItems: 'center', gap: '10px' }}>
                    <Box style={{ width: '34px', height: '34px', borderRadius: '4px', background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: '18px', fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                    </Box>
                    <Box style={{ gap: '2px' }}>
                        <Text style={{ fontSize: '20px', fontWeight: 'bold', color: '#1A2230' }}>SPI 帧连续性</Text>
                        <Text style={{ fontSize: '15px', color: '#8B97A8' }}>10/14</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>现象：分段快读失败，passed_mask=0x06</Text>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>处理：SPI1 MasterKeepIOState 设为 ENABLE</Text>
                <Text style={{ fontSize: '18px', color: '#1E4FA8', lineHeight: '1.5' }}>结果：mask=0x07，BYTE_TEST 正确</Text>
            </Box>
        </Box>
        <Box style={{ width: '1198px', height: '246px', flexDirection: 'row', gap: '20px' }}>
            <Box style={{ width: '386px', height: '246px', background: '#F7F9FC', border: '1px solid #E5E7EB', borderRadius: '6px', padding: '14px 16px', gap: '6px' }}>
                <Box style={{ width: '100%', height: '40px', flexDirection: 'row', alignItems: 'center', gap: '10px' }}>
                    <Box style={{ width: '34px', height: '34px', borderRadius: '4px', background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: '18px', fontWeight: 'bold', color: '#FFFFFF' }}>4</Text>
                    </Box>
                    <Box style={{ gap: '2px' }}>
                        <Text style={{ fontSize: '20px', fontWeight: 'bold', color: '#1A2230' }}>HAL Tick 边界</Text>
                        <Text style={{ fontSize: '15px', color: '#8B97A8' }}>10/14</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>现象：偶发 INIT→PREOP 超时或返回失败</Text>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>处理：首故障快照定位毫秒 Tick 边界</Text>
                <Text style={{ fontSize: '18px', color: '#1E4FA8', lineHeight: '1.5' }}>结果：修正超时换算，快照 valid=0</Text>
            </Box>
            <Box style={{ width: '386px', height: '246px', background: '#F7F9FC', border: '1px solid #E5E7EB', borderRadius: '6px', padding: '14px 16px', gap: '6px' }}>
                <Box style={{ width: '100%', height: '40px', flexDirection: 'row', alignItems: 'center', gap: '10px' }}>
                    <Box style={{ width: '34px', height: '34px', borderRadius: '4px', background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: '18px', fontWeight: 'bold', color: '#FFFFFF' }}>5</Text>
                    </Box>
                    <Box style={{ gap: '2px' }}>
                        <Text style={{ fontSize: '20px', fontWeight: 'bold', color: '#1A2230' }}>主站周期源</Text>
                        <Text style={{ fontSize: '15px', color: '#8B97A8' }}>10/15</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>现象：Cyclic 帧数与 Frames/sec 均为 0</Text>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>处理：启动目标设 SAFEOP，执行 FreeRun</Text>
                <Text style={{ fontSize: '18px', color: '#1E4FA8', lineHeight: '1.5' }}>结果：周期帧开始发送，进入 SAFEOP</Text>
            </Box>
            <Box style={{ width: '386px', height: '246px', background: '#E8EFF8', border: '1px solid #3D7BD9', borderRadius: '6px', padding: '14px 16px', gap: '6px' }}>
                <Box style={{ width: '100%', height: '40px', flexDirection: 'row', alignItems: 'center', gap: '10px' }}>
                    <Box style={{ width: '34px', height: '34px', borderRadius: '4px', background: '#0E3F8C', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: '18px', fontWeight: 'bold', color: '#FFFFFF' }}>6</Text>
                    </Box>
                    <Box style={{ gap: '2px' }}>
                        <Text style={{ fontSize: '20px', fontWeight: 'bold', color: '#1A2230' }}>进入 OP</Text>
                        <Text style={{ fontSize: '15px', color: '#8B97A8' }}>10/15</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>现象：SAFEOP 稳定，State=4、WcState=0</Text>
                <Text style={{ fontSize: '18px', color: '#4A5568', lineHeight: '1.5' }}>处理：保持 ControlWord=0，主站请求 OP</Text>
                <Text style={{ fontSize: '18px', color: '#1E4FA8', lineHeight: '1.5' }}>结果：State=8，计数器达 2127</Text>
            </Box>
        </Box>
        <Box style={{ width: '1198px', height: '56px', background: '#0E3F8C', borderRadius: '6px', padding: '0 20px', flexDirection: 'row', alignItems: 'center', gap: '14px' }}>
            <Box style={{ width: '8px', height: '34px', background: '#FFC107' }} />
            <Text style={{ fontSize: '21px', color: '#FFFFFF' }}>方法要点：每一步只改变一个因素，现象、处理、结果逐项留证</Text>
        </Box>
    </Box>
    <Box style={{ width: '100%', height: '40px', padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: '14px', color: '#8B97A8' }}>时间取自调试记录截图，用于区分轮次，不作为校准过的持续运行计时</Text>
        <Text style={{ fontSize: '15px', fontWeight: 'bold', color: '#1E4FA8' }}>08 / 14</Text>
    </Box>
</Slide>
