<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{33FF3302-F6D2-4AF9-8DC1-2E84436E58DF}">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    (* NON-RETAIN controls. Never force mapped outputs. *)
    bStart : BOOL := FALSE;
    bStop : BOOL := FALSE;
    bDisable : BOOL := FALSE; (* software disable, NOT certified E-stop *)
    bReset : BOOL := FALSE;
    rDemandRpm : REAL := 0.0;
    bFreezeHeartbeat : BOOL := FALSE; (* stage B fault injection only *)
    nPhase : UINT := 0; (* 0 idle, 10 starting, 20 running, 30 slowing, 80 reset ack, 90 fault *)
    bLocalFault : BOOL := FALSE;
    bHealthy : BOOL;
    bHadHealthy : BOOL := FALSE;
    bStartReleased : BOOL := FALSE;
    startEdge : Tc2_Standard.R_TRIG;
    resetEdge : Tc2_Standard.R_TRIG;
    startupTimer : Tc2_Standard.TON;
    stoppedTimer : Tc2_Standard.TON;
    stoppingTimer : Tc2_Standard.TON;
    feedbackTimer : Tc2_Standard.TON;
    resetTimer : Tc2_Standard.TON;
    lastCounter : UDINT := 0;
END_VAR
]]></Declaration>
    <Implementation><ST><![CDATA[
startEdge(CLK := bStart);
resetEdge(CLK := bReset);
IF NOT bStart THEN bStartReleased := TRUE; END_IF;
IF NOT bFreezeHeartbeat THEN
    IF GVL_MotorIO.CommandSequence = UDINT#16#FFFFFFFF THEN
        GVL_MotorIO.CommandSequence := 0;
    ELSE
        GVL_MotorIO.CommandSequence := GVL_MotorIO.CommandSequence + 1;
    END_IF;
END_IF;
bHealthy := NOT GVL_MotorIO.WcState AND (GVL_MotorIO.State = 8);
IF (NOT bHealthy AND (bHadHealthy OR (nPhase <> 0))) OR
   (((GVL_MotorIO.MotorFault <> 0) OR (GVL_MotorIO.BridgeFault <> 0)) AND (nPhase <> 80)) THEN
    nPhase := 90; bLocalFault := TRUE; bStartReleased := FALSE;
END_IF;
IF bHealthy THEN bHadHealthy := TRUE; END_IF;
startupTimer(IN := nPhase = 10, PT := T#2S);
resetTimer(IN := nPhase = 80, PT := T#1S);
stoppingTimer(IN := nPhase = 30, PT := T#2S);
stoppedTimer(IN := (nPhase = 30) AND ((GVL_MotorIO.StatusWord AND WORD#16#0080) <> 0)
                    AND (ABS(INT_TO_DINT(GVL_MotorIO.ActualSpeed)) < 10), PT := T#200MS);
feedbackTimer(IN := ((nPhase = 20) OR (nPhase = 30))
                     AND (GVL_MotorIO.CycleCounter = lastCounter), PT := T#100MS);
lastCounter := GVL_MotorIO.CycleCounter;
GVL_MotorIO.ControlWord := 0;
GVL_MotorIO.TargetSpeed := 0;
CASE nPhase OF
0:
    IF bHealthy AND startEdge.Q AND bStartReleased AND NOT bStop AND NOT bDisable
       AND ((GVL_MotorIO.StatusWord AND WORD#16#0001) <> 0) THEN
        IF (rDemandRpm >= -20.0) AND (rDemandRpm <= 20.0) THEN
            nPhase := 10; bStartReleased := FALSE;
        ELSE nPhase := 90; bLocalFault := TRUE;
        END_IF;
    END_IF;
10:
    GVL_MotorIO.ControlWord := 1; (* start ONLY at zero target *)
    IF bStop THEN nPhase := 0; GVL_MotorIO.ControlWord := 0;
    ELSIF startupTimer.Q THEN nPhase := 90; bLocalFault := TRUE;
    ELSIF (GVL_MotorIO.StatusWord AND WORD#16#0082) = WORD#16#0082 THEN nPhase := 20;
    END_IF;
20:
    GVL_MotorIO.ControlWord := 1;
    IF bStop THEN nPhase := 30;
    ELSIF (rDemandRpm >= -20.0) AND (rDemandRpm <= 20.0) THEN
        GVL_MotorIO.TargetSpeed := REAL_TO_INT(rDemandRpm * 10.0);
    ELSE nPhase := 90; bLocalFault := TRUE;
    END_IF;
30:
    GVL_MotorIO.ControlWord := 1;
    IF stoppedTimer.Q THEN nPhase := 0; GVL_MotorIO.ControlWord := 0;
    ELSIF stoppingTimer.Q THEN nPhase := 90; bLocalFault := TRUE;
    END_IF;
80:
    (* Keep disabled while the slave processes the reset edge. Old PDO faults
       may remain visible for several scans; never treat the write as its ack. *)
    IF (GVL_MotorIO.MotorFault = 0) AND (GVL_MotorIO.BridgeFault = 0)
       AND ((GVL_MotorIO.StatusWord AND WORD#16#0004) = 0) THEN
        nPhase := 0; bLocalFault := FALSE; bStartReleased := FALSE;
    ELSIF resetTimer.Q THEN nPhase := 90; bLocalFault := TRUE;
    END_IF;
90:
    IF resetEdge.Q AND bHealthy AND NOT bStart THEN
        GVL_MotorIO.ControlWord := WORD#16#0080;
        nPhase := 80;
    END_IF;
ELSE
    nPhase := 90; bLocalFault := TRUE;
END_CASE;
IF feedbackTimer.Q THEN nPhase := 90; bLocalFault := TRUE; END_IF;
IF bDisable THEN
    nPhase := 0; bStartReleased := FALSE;
    GVL_MotorIO.ControlWord := 0; GVL_MotorIO.TargetSpeed := 0;
END_IF;
IF nPhase = 90 THEN GVL_MotorIO.ControlWord := 0; GVL_MotorIO.TargetSpeed := 0; END_IF;
]]></ST></Implementation>
  </POU>
</TcPlcObject>
